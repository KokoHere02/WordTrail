# Copy to .env; create the matching database/user in the existing MySQL first.
# MYSQL_PASSWORD is the dedicated wordtrail user's password, not the root password.
# PowerShell, generate each secret independently:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# For Windows PowerShell 5.1, see the compatible command in docs/docker.md.
MYSQL_PASSWORD=
JWT_SECRET_BASE64=

MYSQL_HOST=shop-system-db
MYSQL_NETWORK=wordtrail-db
MYSQL_DATABASE=word_trail_db
MYSQL_USER=wordtrail
APP_PORT=8081
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: set to 1 to allow the seeded test account to maintain the sentence bank.
SENTENCE_EDITOR_USER_IDS=
# RAM user credentials and system-provided signature from the PNVS console.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
SMS_DAILY_LIMIT=10
# QQ mailbox and SMTP authorization code (never commit real credentials).
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DAILY_LIMIT=100
# URL reachable by the backend container; localhost inside it refers to that container.
PIPER_URL=http://host.docker.internal:5000
PIPER_US_VOICE=en_US-lessac-medium
PIPER_UK_VOICE=en_GB-alan-medium
